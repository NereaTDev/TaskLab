{
    frankenphp
    servers {
        trusted_proxies static private_ranges
    }
}

:10000 {
    root * /var/www/html/public

    encode zstd br gzip

    # Servir assets estáticos directamente (no pasan por PHP)
    @static {
        file
        path *.css *.js *.ico *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.ttf *.webp
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    php_server
}
